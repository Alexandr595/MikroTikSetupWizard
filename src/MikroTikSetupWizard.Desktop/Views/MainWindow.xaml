<Window x:Class="MikroTikSetupWizard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:MikroTikSetupWizard.Desktop.Behaviors"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MikroTik Setup Wizard"
        Width="1440"
        Height="760"
        MinWidth="1240"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#263041" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2F3A4F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#A92318" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,0">
                        <GradientStop Color="#151A23" Offset="0" />
                        <GradientStop Color="#10141C" Offset="0.62" />
                        <GradientStop Color="#0C1017" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="26"
                                Height="26"
                                CornerRadius="7"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="M"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                        </Border>

                        <TextBlock Text="MikroTik Setup Wizard"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="−"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_OnClick" />
                        <Button Content="□"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="MaximizeButton_OnClick" />
                        <Button Content="×"
                                Style="{StaticResource CloseTitleBarButtonStyle}"
                                Click="CloseButton_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,24,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="18"
                        Margin="0,0,0,18"
                        Visibility="{Binding HasCurrentDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20"
                                          ShadowDepth="0"
                                          Opacity="0.14"
                                          Color="#000000" />
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="38"
                                Height="38"
                                CornerRadius="12"
                                Background="#1E344C"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                Margin="0,0,14,0">
                            <TextBlock Text="M"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Текущее устройство"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentDevice.Identity}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="IP:"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="{Binding CurrentDevice.IpAddress}"
                                           Margin="0,0,18,0" />
                                <TextBlock Text="RouterOS:"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="{Binding CurrentDevice.RouterOsVersion}"
                                           Margin="0,0,18,0" />
                                <TextBlock Text="Board:"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="{Binding CurrentDevice.Board}"
                                           Margin="0,0,18,0" />
                                <TextBlock Text="Метод:"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="{Binding CurrentDevice.DiscoveryMethod}" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="Подключиться"
                                    Command="{Binding OpenCurrentDeviceConnectionCommand}"
                                    Margin="0,0,10,0" />
                            <Button Content="Сменить"
                                    Command="{Binding ShowDiagnosticsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
        <Grid Grid.Row="1" Visibility="{Binding IsHomeScreenVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,28">
                <TextBlock Text="MikroTik Setup Wizard"
                           Style="{StaticResource TitleTextStyle}" />
                <TextBlock Text="Выберите задачу, а приложение покажет только нужные шаги."
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="16" />
            </StackPanel>

            <UniformGrid Grid.Row="1"
                         Columns="3"
                         Rows="1">
                <Button Command="{Binding ShowConfigureDeviceCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,18,0"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Настроить устройство"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Пошаговые мастера для типовых сетевых задач."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ShowDiagnosticsCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,18,0"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Проверить устройство"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Будущий помощник диагностики RouterOS и рекомендаций."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ShowAdvancedModeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Расширенный режим"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Device Role, Module Navigation и текущий Basic Network сценарий."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsConfigureDeviceScreenVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Content="Назад"
                        Command="{Binding ShowHomeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,18,0" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Настроить устройство"
                               Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Text="Выберите понятный сценарий. Технические модули будут подобраны внутри приложения."
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SetupTasks}"
                              Margin="0,0,16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenSetupTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding IsAvailable}"
                                    Width="300"
                                    MinHeight="168"
                                    Margin="0,0,18,18"
                                    Padding="20">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="Opacity" Value="0.52" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Description}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,10,0,18" />
                                    <Border Grid.Row="2"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,4">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsOfficeRouterWizardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="580"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="18"
                  Padding="28"
                  Visibility="{Binding HasNoCurrentDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Сначала выберите MikroTik"
                               Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Text="Откройте раздел &quot;Проверить устройство&quot;, найдите MikroTik и нажмите &quot;Выбрать устройство&quot;. После этого мастер будет работать с выбранным текущим устройством."
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,18" />
                    <Button Content="Перейти к поиску устройства"
                            Command="{Binding ShowDiagnosticsCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Grid DataContext="{Binding OfficeRouterWizard}"
                  Visibility="{Binding DataContext.HasCurrentDevice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Content="Назад к выбору задач"
                            Command="{Binding DataContext.ShowConfigureDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,18,0" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Офисный роутер"
                                   Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Text="Пошаговый мастер настройки без лишних технических деталей. Генерация .rsc будет подключена на следующем этапе."
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="22"
                            Margin="0,0,20,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24"
                                              ShadowDepth="0"
                                              Opacity="0.18"
                                              Color="#000000" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,16">
                                <TextBlock Text="Шаги мастера"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Заполните только параметры, которые нужны для выбранной задачи."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Steps}"
                                              Margin="0,0,10,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12"
                                                    Padding="13"
                                                    Margin="0,0,0,10">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Background" Value="#172334" />
                                                                <Setter Property="BorderBrush" Value="#274461" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Background" Value="#1B2A3F" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#C8962F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="24"
                                                            Height="24"
                                                            CornerRadius="12"
                                                            Margin="0,1,12,0">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="✓"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FFFFFF" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="28">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24"
                                              ShadowDepth="0"
                                              Opacity="0.18"
                                              Color="#000000" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,20">
                                <TextBlock Text="{Binding CurrentStep.Title}"
                                           Style="{StaticResource TitleTextStyle}" />
                                <TextBlock Text="{Binding CurrentStep.Description}"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid Margin="0,0,16,0">
                                    <Border Visibility="{Binding IsInternetStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel MaxWidth="680"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="Интернет"
                                                       Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,0,10" />

                                            <TextBlock Text="Имя роутера"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Input.RouterName, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="WAN interface"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Input.WanInterface, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="Тип подключения"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding Input.InternetConnectionTypes}"
                                                      SelectedItem="{Binding Input.InternetConnectionType}" />
                                            <TextBlock Text="Static IP и PPPoE пока показаны как будущие варианты и не меняют генерацию."
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12"
                                                       Margin="0,-2,0,10" />

                                            <TextBlock Text="DNS servers"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Input.DnsServers, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Visibility="{Binding IsLocalNetworkStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel MaxWidth="680"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="Локальная сеть"
                                                       Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,0,10" />

                                            <TextBlock Text="LAN bridge name"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Input.LanBridgeName, UpdateSourceTrigger=PropertyChanged}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,12,0">
                                                    <TextBlock Text="LAN gateway IP"
                                                               Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Input.LanAddress, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="CIDR"
                                                               Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox ItemsSource="{Binding Input.PrefixLengths}"
                                                              SelectedItem="{Binding Input.LanPrefixLength}" />
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox Content="Включить DHCP"
                                                      IsChecked="{Binding Input.DhcpEnabled}" />

                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,12,0">
                                                    <TextBlock Text="DHCP range start"
                                                               Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Input.DhcpPoolStart, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="DHCP range end"
                                                               Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Input.DhcpPoolEnd, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Visibility="{Binding IsSecurityStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel MaxWidth="680"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="Безопасность"
                                                       Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,0,10" />

                                            <TextBlock Text="Admin username"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Input.AdminUserName, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="Admin password"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <PasswordBox x:Name="OfficeAdminPasswordBox"
                                                         PasswordChanged="OfficeAdminPasswordBox_OnPasswordChanged" />

                                            <Border Background="#3A2F12"
                                                    BorderBrush="#C8962F"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12"
                                                    Margin="0,6,0,4"
                                                    Visibility="{Binding Input.HasEmptyAdminPasswordWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Пароль администратора пустой. Это допустимо для макета, но в рабочем мастере будет предупреждением."
                                                           Foreground="#F1C66A" />
                                            </Border>

                                            <CheckBox Content="Включить NAT masquerade"
                                                      IsChecked="{Binding Input.EnableNat}" />
                                            <CheckBox Content="Включить базовый firewall"
                                                      IsChecked="{Binding Input.EnableBasicFirewall}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Visibility="{Binding IsReviewStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel MaxWidth="760"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="Проверка"
                                                       Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,0,10" />
                                            <TextBlock Text="На этом этапе мастер покажет ошибки, предупреждения и итоговый список объектов RouterOS."
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="0,0,0,18" />

                                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="16"
                                                    Margin="0,0,12,16">
                                                <StackPanel>
                                                    <TextBlock Text="Сводка настройки"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,12" />

                                                    <UniformGrid Columns="2">
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="Имя роутера:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryRouterName}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="WAN:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryWan}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="LAN:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryLan}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="DHCP:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryDhcp}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="DNS:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryDns}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="NAT:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryNat}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="Firewall:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryFirewall}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="Администратор:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryAdmin}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#331A1D"
                                                    BorderBrush="{DynamicResource DangerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="14"
                                                    Margin="0,0,12,14"
                                                    Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="Ошибки"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               Margin="0,0,0,8" />
                                                    <ItemsControl ItemsSource="{Binding ValidationErrors}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           Margin="0,0,0,4" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#332A16"
                                                    BorderBrush="#C8962F"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="14"
                                                    Margin="0,0,12,14"
                                                    Visibility="{Binding HasValidationWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="Предупреждения"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F1C66A"
                                                               Margin="0,0,0,8" />
                                                    <ItemsControl ItemsSource="{Binding ValidationWarnings}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           Margin="0,0,0,4" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{Binding ValidationMessage}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="0,0,0,10" />
                                        </StackPanel>
                                    </Border>

                                    <Border Visibility="{Binding IsResultStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0"
                                                        Margin="0,0,0,16">
                                                <TextBlock Text="Результат"
                                                           Style="{StaticResource SectionTitleStyle}"
                                                           Margin="0,0,0,10" />
                                                <TextBlock Text="Проверьте итоговый .rsc и сохраните файл."
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding SummaryRouterName, StringFormat=Имя роутера: {0}}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Margin="0,6,0,0" />

                                            </StackPanel>

                                            <TextBox Grid.Row="1"
                                                     Text="{Binding GeneratedRsc, Mode=OneWay}"
                                                     FontFamily="Consolas"
                                                     FontSize="13"
                                                     MinHeight="260"
                                                     AcceptsReturn="True"
                                                     IsReadOnly="True"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2"
                      Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Content="Назад"
                                Command="{Binding BackCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Сгенерировать .rsc"
                                Command="{Binding GeneratePreviewCommand}"
                                Visibility="{Binding IsGenerateActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Далее"
                                Command="{Binding NextCommand}"
                                Visibility="{Binding IsNextActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Сохранить .rsc"
                                Command="{Binding SaveFileCommand}"
                                Visibility="{Binding IsSaveActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Вернуться к выбору задач"
                                Command="{Binding DataContext.ShowConfigureDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding IsReturnToTaskSelectionActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsAccessPointWizardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="580"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="18"
                  Padding="28"
                  Visibility="{Binding HasNoCurrentDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Сначала выберите MikroTik"
                               Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Text="Откройте раздел &quot;Проверить устройство&quot;, найдите MikroTik и нажмите &quot;Выбрать устройство&quot;. После этого мастер будет работать с выбранным текущим устройством."
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,18" />
                    <Button Content="Перейти к поиску устройства"
                            Command="{Binding ShowDiagnosticsCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Grid DataContext="{Binding AccessPointWizard}"
                  Visibility="{Binding DataContext.HasCurrentDevice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Content="Назад к выбору задач"
                            Command="{Binding DataContext.ShowConfigureDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,18,0" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Точка доступа"
                                   Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Text="Мастер для MikroTik внутри уже существующей сети: bridge, DHCP client и опциональный Wi-Fi."
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="22"
                            Margin="0,0,20,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24"
                                              ShadowDepth="0"
                                              Opacity="0.18"
                                              Color="#000000" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,16">
                                <TextBlock Text="Шаги мастера"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Только параметры точки доступа, без NAT, DHCP server и firewall."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Steps}"
                                              Margin="0,0,10,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12"
                                                    Padding="13"
                                                    Margin="0,0,0,10">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Background" Value="#172334" />
                                                                <Setter Property="BorderBrush" Value="#274461" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Background" Value="#1B2A3F" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#C8962F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="24"
                                                            Height="24"
                                                            CornerRadius="12"
                                                            Margin="0,1,12,0">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="✓"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FFFFFF" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="28">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24"
                                              ShadowDepth="0"
                                              Opacity="0.18"
                                              Color="#000000" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,20">
                                <TextBlock Text="{Binding CurrentStep.Title}"
                                           Style="{StaticResource TitleTextStyle}" />
                                <TextBlock Text="{Binding CurrentStep.Description}"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid Margin="0,0,16,0">
                                    <Border Visibility="{Binding IsBasicStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel MaxWidth="680"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="Основное"
                                                       Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,0,10" />

                                            <TextBlock Text="Имя устройства"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Input.DeviceName, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="Bridge name"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Input.BridgeName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Visibility="{Binding IsNetworkStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel MaxWidth="680"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="Сеть"
                                                       Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,0,10" />
                                            <TextBlock Text="Способ получения IP"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <RadioButton Content="DHCP Client"
                                                         GroupName="AccessPointIpMode"
                                                         IsChecked="{Binding Input.UseDhcpClient}" />
                                            <RadioButton Content="Статический IP"
                                                         GroupName="AccessPointIpMode"
                                                         IsChecked="{Binding Input.UseStaticManagementIp}" />
                                            <TextBlock Text="В режиме DHCP точка доступа получит адрес из существующей сети."
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12"
                                                       Margin="0,8,0,0" />

                                            <StackPanel Margin="0,14,0,0"
                                                        Visibility="{Binding Input.UseStaticManagementIp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="IP адрес управления"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Input.ManagementIpAddress, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Text="CIDR"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox ItemsSource="{Binding Input.PrefixLengths}"
                                                          SelectedItem="{Binding Input.ManagementPrefixLength}" />

                                                <TextBlock Text="Шлюз"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Input.DefaultGateway, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Text="DNS серверы"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Input.DnsServers, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Visibility="{Binding IsWifiStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel MaxWidth="680"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="Wi-Fi"
                                                       Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,0,10" />

                                            <TextBlock Text="Тип Wi-Fi"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <RadioButton Content="Без Wi-Fi"
                                                         GroupName="AccessPointWifiMode"
                                                         IsChecked="{Binding Input.UseNoWifi}" />
                                            <RadioButton Content="RouterOS 7 WiFi"
                                                         GroupName="AccessPointWifiMode"
                                                         IsChecked="{Binding Input.UseRouterOs7Wifi}" />

                                            <StackPanel Margin="0,14,0,0"
                                                        Visibility="{Binding Input.IsWifiSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="SSID"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Input.Ssid, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Text="Пароль Wi-Fi"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Input.WifiPassword, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Text="Будут сгенерированы только команды /interface wifi для RouterOS 7."
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           Margin="0,0,0,10" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Visibility="{Binding IsReviewStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel MaxWidth="760"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="Проверка"
                                                       Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,0,10" />
                                            <TextBlock Text="Проверьте параметры точки доступа перед генерацией .rsc."
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="0,0,0,18" />

                                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="16"
                                                    Margin="0,0,12,16">
                                                <StackPanel>
                                                    <TextBlock Text="Сводка настройки"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,12" />
                                                    <UniformGrid Columns="2">
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="Имя устройства:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryDeviceName}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="Bridge:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryBridgeName}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="Тип адресации:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryAddressMode}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12"
                                                                    Visibility="{Binding Input.UseStaticManagementIp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="IP:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryManagementIp}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12"
                                                                    Visibility="{Binding Input.UseStaticManagementIp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="Шлюз:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryGateway}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12"
                                                                    Visibility="{Binding Input.UseStaticManagementIp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="DNS:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryDns}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="LAN-порты:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="все ethernet interfaces" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12">
                                                            <TextBlock Text="Тип Wi-Fi:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryWifiType}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12"
                                                                    Visibility="{Binding IsWifiSummaryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="SSID:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummarySsid}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,12"
                                                                    Visibility="{Binding IsWifiSummaryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="Пароль Wi-Fi:" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding SummaryWifiPassword}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#331A1D"
                                                    BorderBrush="{DynamicResource DangerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="14"
                                                    Margin="0,0,12,14"
                                                    Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="Ошибки"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               Margin="0,0,0,8" />
                                                    <ItemsControl ItemsSource="{Binding ValidationErrors}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           Margin="0,0,0,4" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#332A16"
                                                    BorderBrush="#C8962F"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="14"
                                                    Margin="0,0,12,14"
                                                    Visibility="{Binding HasValidationWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="Предупреждения"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F1C66A"
                                                               Margin="0,0,0,8" />
                                                    <ItemsControl ItemsSource="{Binding ValidationWarnings}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           Margin="0,0,0,4" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{Binding ValidationMessage}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="0,0,0,10" />
                                        </StackPanel>
                                    </Border>

                                    <Border Visibility="{Binding IsResultStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0"
                                                        Margin="0,0,0,16">
                                                <TextBlock Text="Результат"
                                                           Style="{StaticResource SectionTitleStyle}"
                                                           Margin="0,0,0,10" />
                                                <TextBlock Text="Проверьте итоговый .rsc и сохраните файл."
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>

                                            <TextBox Grid.Row="1"
                                                     Text="{Binding GeneratedRsc, Mode=OneWay}"
                                                     FontFamily="Consolas"
                                                     FontSize="13"
                                                     MinHeight="260"
                                                     AcceptsReturn="True"
                                                     IsReadOnly="True"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2"
                      Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Content="Назад"
                                Command="{Binding BackCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Сгенерировать .rsc"
                                Command="{Binding GeneratePreviewCommand}"
                                Visibility="{Binding IsGenerateActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Далее"
                                Command="{Binding NextCommand}"
                                Visibility="{Binding IsNextActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Сохранить .rsc"
                                Command="{Binding SaveFileCommand}"
                                Visibility="{Binding IsSaveActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Вернуться к выбору задач"
                                Command="{Binding DataContext.ShowConfigureDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding IsReturnToTaskSelectionActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsDiagnosticsScreenVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Content="Назад"
                    Command="{Binding ShowHomeCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,24" />

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid DataContext="{Binding DeviceDiscovery}"
                      MaxWidth="920"
                      Margin="0,0,18,28"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="22"
                        Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.18"
                                          Color="#000000" />
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,18,0">
                            <TextBlock Text="Найти MikroTik рядом"
                                       Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="MNDP ищет устройства только в одной L2-сети. Поиск не проходит через роутеры/VLAN, не сканирует подсети и не выполняет авторизацию."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Найти MikroTik рядом"
                                Command="{Binding FindDevicesCommand}"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="22"
                        Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.18"
                                          Color="#000000" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Проверить IP вручную"
                                   Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Grid.Row="1"
                                   Text="Ручной ввод IP выполняет только read-only проверку доступности: ping и TCP probe портов 8291/22/8728 без авторизации. Это не меняет конфигурацию и не подтверждает identity без MNDP/API."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <Grid Grid.Row="2"
                              Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="IP адрес"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding ManualIpAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Добавить по IP"
                                    Command="{Binding AddManualDeviceCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="14,24,0,0"
                                    VerticalAlignment="Top" />
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.14"
                                          Color="#000000" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Результаты проверки"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1"
                                   Text="Пока нет проверенных IP"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Visibility="{Binding HasNoDevices, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="0,0,0,10" />

                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding DeviceCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0"
                                                  Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,14,0" />

                                                <Border Grid.Column="1"
                                                        Background="#223A52"
                                                        BorderBrush="#385D82"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="9,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}"
                                                               Foreground="#A9D4FF"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Background="#12161E"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12"
                                                        Margin="0,0,6,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Устройство"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,0,10" />

                                                        <TextBlock Text="Identity"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding Identity}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,8" />

                                                        <TextBlock Text="IP"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding IpAddress}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,8" />

                                                        <TextBlock Text="MAC"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding MacAddress}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1"
                                                        Background="#12161E"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12"
                                                        Margin="6,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Система"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,0,10" />

                                                        <TextBlock Text="Board / Platform"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding BoardName}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,8" />

                                                        <TextBlock Text="RouterOS Version"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding RouterOsVersion}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,8" />

                                                        <TextBlock Text="Интерфейс обнаружения"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding InterfaceName}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,8" />

                                                        <TextBlock Text="Метод обнаружения"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding DiscoveryMethod}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        Margin="0,14,0,0">
                                                <Button Content="Проверить сервисы"
                                                        Command="{Binding DataContext.RunDeviceDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Device}"
                                                        Margin="0,0,10,0" />
                                                <Button Content="Выбрать устройство"
                                                        Command="{Binding DataContext.SelectCurrentDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Device}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="22"
                        Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.14"
                                          Color="#000000" />
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Диагностика устройства"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Проверяются только ping и фиксированный список TCP-портов: WinBox, SSH, API, API-SSL, HTTP и HTTPS. Авторизация и команды RouterOS не выполняются."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="{Binding DiagnosticsStatusMessage}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <Grid Visibility="{Binding HasDiagnosticsResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Identity:"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,10,6" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DiagnosticsResult.Identity}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,22,6" />
                                    <TextBlock Grid.Column="2"
                                               Text="IP:"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,10,6" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding DiagnosticsResult.IpAddress}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />

                                    <TextBlock Grid.Row="1"
                                               Text="MAC:"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,10,6" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding DiagnosticsResult.MacAddress}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,22,6" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="2"
                                               Text="Board:"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,10,6" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="3"
                                               Text="{Binding DiagnosticsResult.BoardName}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />

                                    <TextBlock Grid.Row="2"
                                               Text="RouterOS:"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,10,0" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding DiagnosticsResult.RouterOsVersion}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,22,0" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="2"
                                               Text="Метод:"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,10,0" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="3"
                                               Text="{Binding DiagnosticsResult.DiscoveryMethod}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ping"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="Не удалось определить" />
                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DiagnosticsResult.Ping.Status}" Value="Open">
                                                        <Setter Property="Text" Value="Отвечает" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DiagnosticsResult.Ping.Status}" Value="Timeout">
                                                        <Setter Property="Text" Value="Timeout" />
                                                        <Setter Property="Foreground" Value="#E7C875" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DiagnosticsResult.Ping.Details}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <ItemsControl Grid.Row="2"
                                          ItemsSource="{Binding DiagnosticsResult.Services}"
                                          Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Port}"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Grid.Column="2"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Text" Value="Не удалось определить" />
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Open">
                                                                    <Setter Property="Text" Value="Открыт" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                                    <Setter Property="Text" Value="Закрыт" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Timeout">
                                                                    <Setter Property="Text" Value="Timeout" />
                                                                    <Setter Property="Foreground" Value="#E7C875" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Details}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Grid.Row="3">
                                <TextBlock Text="Рекомендации по результатам"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding DiagnosticsResult.Recommendations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="22"
                        Margin="0,0,0,16"
                        Visibility="{Binding IsConnectionFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.14"
                                          Color="#000000" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Подключение к устройству"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,12" />

                        <Grid Grid.Row="1"
                              Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,0">
                                <TextBlock Text="IP"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding ConnectionIp}"
                                         IsReadOnly="True" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Login"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding ConnectionLogin, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2"
                              Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Password"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <PasswordBox behaviors:PasswordBoxBinding.IsEnabled="True"
                                             behaviors:PasswordBoxBinding.Password="{Binding ConnectionPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Метод"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding ConnectionMethodDisplay, Mode=OneWay}"
                                         IsReadOnly="True" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3"
                                Background="#2A2416"
                                BorderBrush="#80682E"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,12">
                            <TextBlock Text="Автоматический подбор паролей не выполняется. Введите пароль вручную. Проверьте наклейку устройства или данные администратора."
                                       Foreground="#E7C875"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Grid.Row="4"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,12"
                                Visibility="{Binding HasHostKeyFingerprint, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="SSH host key"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding HostKeyAlgorithm, StringFormat=Алгоритм: {0}}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HostKeyFingerprint, StringFormat=Fingerprint: {0}}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="Проверить подключение"
                                    Command="{Binding ConnectToDeviceCommand}"
                                    Margin="0,0,16,0" />
                            <Button Grid.Column="1"
                                    Content="Доверять ключу и продолжить"
                                    Command="{Binding TrustHostKeyCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,16,0"
                                    Visibility="{Binding IsHostKeyConfirmationRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ConnectionStatusMessage}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="6"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,14,0,0"
                                Visibility="{Binding HasDeviceInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Информация RouterOS"
                                           FontWeight="SemiBold"
                                           FontSize="16"
                                           Margin="0,0,0,10" />

                                <Grid Grid.Row="1"
                                      Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Identity:"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,12,5" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding DeviceInfo.Identity}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1"
                                               Text="RouterOS:"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,12,5" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding DeviceInfo.RouterOsVersion}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2"
                                               Text="Board/model:"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,12,5" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding DeviceInfo.BoardName}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3"
                                               Text="Uptime:"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{Binding DeviceInfo.Uptime}"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Интерфейсы"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />
                                    <ListBox ItemsSource="{Binding DeviceInfo.Interfaces}"
                                             MaxHeight="220"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,8,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Type}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="2"
                                                               Foreground="{DynamicResource MutedTextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Text" Value="Неактивен" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="Text" Value="Работает" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                        <Setter Property="Text" Value="Отключён" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="5"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.12"
                                          Color="#000000" />
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Рекомендации"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Content="Назад"
                        Command="{Binding ShowHomeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,18,0" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding WorkspaceTitle}"
                               Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Text="{Binding WorkspaceDescription}"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ModuleNavigationColumnWidth}" />
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Visibility="{Binding IsAdvancedModeActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.18"
                                          Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Роль устройства"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,0,0,10" />
                            <ComboBox ItemsSource="{Binding DeviceRoles}"
                                      SelectedItem="{Binding SelectedDeviceRole}"
                                      DisplayMemberPath="Name" />
                            <TextBlock Text="{Binding SelectedDeviceRole.Description}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,2,0,16" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="Модули"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,10,0,10" />

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ModuleNavigationItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,10,10">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Предупреждение">
                                                            <Setter Property="BorderBrush" Value="#C8962F" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAllowed}" Value="False">
                                                            <Setter Property="Opacity" Value="0.52" />
                                                            <Setter Property="BorderBrush" Value="#3A3F4B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="1"
                                                            CornerRadius="8"
                                                            Padding="8,3"
                                                            Margin="10,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Background" Value="#202737" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Включён">
                                                                        <Setter Property="Background" Value="#173826" />
                                                                        <Setter Property="BorderBrush" Value="#2F9E5F" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Предупреждение">
                                                                        <Setter Property="Background" Value="#3A2F12" />
                                                                        <Setter Property="BorderBrush" Value="#C8962F" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Заблокирован">
                                                                        <Setter Property="Background" Value="#231F25" />
                                                                        <Setter Property="BorderBrush" Value="#4B2E38" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding DisabledReason}"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           FontSize="12"
                                                           Margin="0,6,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DisabledReason}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Warning}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="12"
                                                           Margin="0,6,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Warning}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Margin="{Binding ConfigurationPanelMargin}"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="26">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.18"
                                          Color="#000000" />
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="MikroTik Setup Wizard" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="Первичная настройка RouterOS" Foreground="{DynamicResource MutedTextBrush}" />

                            <TextBlock Text="Устройство" Style="{StaticResource SectionTitleStyle}" />

                            <Button Content="Профиль: Малый офис"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ApplySmallOfficeProfileCommand}" />

                            <TextBlock Text="Имя роутера" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding RouterName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Версия RouterOS" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding RouterOsVersions}"
                                      SelectedItem="{Binding SelectedRouterOsVersion}" />

                            <TextBlock Text="Интерфейсы" Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Text="WAN-интерфейс" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding WanInterface, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="LAN bridge" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding LanBridgeName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="LAN" Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Text="IP/CIDR LAN gateway" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding LanAddress, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Префикс сети" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding PrefixLengths}"
                                      SelectedItem="{Binding SelectedPrefixLength}" />

                            <TextBlock Text="Начало DHCP-пула" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding DhcpPoolStart, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Конец DHCP-пула" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding DhcpPoolEnd, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="DNS-серверы" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding DnsServers, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Администратор" Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Text="Имя администратора" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding AdminUserName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Пароль администратора" Style="{StaticResource FieldLabelStyle}" />
                            <PasswordBox x:Name="AdminPasswordBox"
                                         PasswordChanged="AdminPasswordBox_OnPasswordChanged" />

                            <CheckBox Content="Включить NAT masquerade"
                                      IsChecked="{Binding EnableNat}" />
                            <CheckBox Content="Добавить базовый firewall"
                                      IsChecked="{Binding EnableBasicFirewall}" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Сгенерировать"
                                        Command="{Binding GeneratePreviewCommand}" />
                                <Button Content="Сохранить .rsc"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding SaveFileCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Margin="0,14,0,0" />

                            <TextBlock Text="{Binding ValidationMessage}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2"
                        Margin="20,0,0,0"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="26">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.18"
                                          Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="Предпросмотр .rsc" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="Скрипт генерируется из ConfigurationPlan и готов к сохранению."
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <TextBox Grid.Row="1"
                                 Text="{Binding GeneratedRsc, Mode=OneWay}"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 IsReadOnly="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>
        </Grid>
    </Border>
</Window>
